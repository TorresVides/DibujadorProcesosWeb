# ===========================================================================
# DibujadorProcesosWeb - plantilla de variables de entorno
# ===========================================================================
#
# ESTE ARCHIVO SI SE VERSIONA. Contiene unicamente valores de ejemplo.
# NUNCA escribas aqui una contrasena real.
#
# Primer paso al clonar el repositorio:
#
#     cp .env.example .env
#
# y reemplaza POSTGRES_PASSWORD por un valor local propio. El archivo `.env`
# esta ignorado por Git (ver .gitignore) y nunca debe subirse.
#
# Quien consume estas variables:
#   - Docker Compose las lee automaticamente desde `.env` para el servicio
#     `db` y para construir la URL del datasource del servicio `app`.
#   - Spring Boot las lee en ejecucion local mediante la propiedad
#     `spring.config.import=optional:file:./.env[.properties]`
#     declarada en src/main/resources/application.properties.
# ===========================================================================

# --- Base de datos PostgreSQL --------------------------------------------
# Nombre de la base de datos que crea el contenedor en su primer arranque.
POSTGRES_DB=dibujador_procesos

# Usuario de aplicacion (tambien es el superusuario del contenedor).
POSTGRES_USER=dibujador_app

# Contrasena LOCAL de desarrollo. Valor de ejemplo: cambialo en tu `.env`.
# No reutilices contrasenas personales ni de otros servicios.
POSTGRES_PASSWORD=cambia_esta_clave_en_tu_env_local

# --- Conexion desde ejecucion local (fuera de Docker) --------------------
# Con `docker compose up`, PostgreSQL queda publicado en el host en el 5433
# (mapeo 5433:5432) para no chocar con un PostgreSQL instalado en el 5432.
# Dentro de Docker, el servicio `app` ignora estos valores: recibe
# SPRING_DATASOURCE_URL apuntando al host `db` en el puerto 5432.
DB_HOST=localhost
DB_PORT=5433

# --- Aplicacion -----------------------------------------------------------
SERVER_PORT=8080
