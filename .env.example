# Copiar a .env y ajustar POSTGRES_PASSWORD. El .env real no se versiona.
# Lo consumen Docker Compose y Spring Boot (spring.config.import en application.properties).

POSTGRES_DB=dibujador_procesos
POSTGRES_USER=dibujador_app
POSTGRES_PASSWORD=cambia_esta_clave_en_tu_env_local

# Conexión desde ejecución local, fuera de Docker.
DB_HOST=localhost
DB_PORT=5433

SERVER_PORT=8080
