# El Maven Wrapper sí se versiona. Estas negaciones van después de *.jar y target/
# porque en .gitignore gana la última regla que coincide.
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper.jar
!mvnw
!mvnw.cmd
!**/src/main/**/target/
!**/src/test/**/target/

